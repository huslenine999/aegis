FROM node:22.21.1-bookworm-slim@sha256:25b3eb23a00590b7499f2a2ce939322727fcce1b15fdd69754fcd09536a3ae2c AS node

FROM python:3.11.15-slim-bookworm@sha256:721dc13fd1be0a771e54b72097634291d628d0007dee9da777e2ce676a9c998f
RUN groupadd --gid 10001 codeql && useradd --uid 10001 --gid codeql --no-create-home codeql
# CodeQL's TypeScript extractor runs on Node.js.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --chown=10001:10001 codeql /opt/codeql
USER 10001:10001

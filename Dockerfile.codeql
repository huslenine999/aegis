FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS node

FROM python:3.15.0-slim-bookworm@sha256:0e019bbdfb5d9874cb2389f1c2884b64aa2ac97c99960b5bc521cef978c0617d
RUN groupadd --gid 10001 codeql && useradd --uid 10001 --gid codeql --no-create-home codeql
# CodeQL's TypeScript extractor runs on Node.js.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --chown=10001:10001 codeql /opt/codeql
USER 10001:10001

AEGIS_DOMAIN=aegis.example.com
AEGIS_PUBLIC_URL=https://aegis.example.com
AEGIS_ALLOWED_HOSTS=aegis.example.com,localhost,127.0.0.1
AEGIS_CORS_ORIGINS=https://aegis.example.com
AEGIS_SESSION_SECRET=replace-with-at-least-32-random-characters
AEGIS_TOKEN_PEPPER=replace-with-a-separate-32-character-token-pepper
AEGIS_AUDIT_HMAC_KEY=replace-with-a-separate-32-character-audit-key
AEGIS_SECURITY_PROFILE=standard
AEGIS_REQUIRE_NOTIFIER=true
AEGIS_BOOTSTRAP_ADMIN_USERNAME=admin
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=
AEGIS_SETUP_TOKEN=replace-with-at-least-32-random-characters
AEGIS_ENCRYPTION_KEY=replace-with-a-fernet-key
AEGIS_GITHUB_CLIENT_ID=
AEGIS_GITHUB_CLIENT_SECRET=
AEGIS_GITHUB_CALLBACK_URL=https://aegis.example.com/api/github/callback
AEGIS_GITHUB_APP_ID=
AEGIS_GITHUB_APP_PRIVATE_KEY_B64=
AEGIS_GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AEGIS_COMMERCIAL_CONTACT_URL=https://github.com/huslenine999/aegis/issues/new
AEGIS_SMTP_HOST=
AEGIS_SMTP_PORT=587
AEGIS_SMTP_USERNAME=
AEGIS_SMTP_PASSWORD=
AEGIS_SMTP_FROM=aegis@example.com
AEGIS_METRICS_TOKEN=replace-with-a-random-monitoring-token
AEGIS_MAX_UPLOAD_BYTES=1048576
AEGIS_MAX_REQUEST_BYTES=1114112
AEGIS_ARTIFACT_RETENTION_DAYS=30
AEGIS_ARTIFACT_BACKEND=local
AEGIS_SCAN_JOB_TIMEOUT_SECONDS=3600
AEGIS_SANDBOX_COMMAND_TIMEOUT_SECONDS=300
AEGIS_SCANNER_TIMEOUT_SECONDS=300
AEGIS_SANDBOX_MAX_FILES=100000
AEGIS_SANDBOX_MAX_CONTEXT_BYTES=2147483648
# Resource budgets: scanner output, parser input, downloads, and ZIP bundles.
AEGIS_MAX_SUBPROCESS_OUTPUT_BYTES=8388608
AEGIS_MAX_PARSER_INPUT_BYTES=16777216
AEGIS_MAX_RESPONSE_BYTES=67108864
AEGIS_MAX_ZIP_ENTRIES=256
AEGIS_MAX_ZIP_UNCOMPRESSED_BYTES=67108864
AEGIS_STREAM_CHUNK_BYTES=65536
AEGIS_LOGIN_FAILURE_LIMIT=5
AEGIS_LOGIN_LOCKOUT_SECONDS=900
AEGIS_RECENT_AUTH_SECONDS=600
AEGIS_ALLOW_DEEP_SCANS=false
AEGIS_ISOLATED_WORKER=false
AEGIS_ARTIFACT_BACKEND=local
# S3-compatible evidence storage
AEGIS_S3_BUCKET=
AEGIS_S3_REGION=
AEGIS_S3_PREFIX=aegis
AEGIS_S3_ENDPOINT_URL=
AEGIS_S3_KMS_KEY_ID=
AEGIS_S3_OBJECT_LOCK_DAYS=0
# Enterprise OIDC
AEGIS_OIDC_ISSUER=
# Optional comma-separated exact HTTPS origins for provider endpoints that do
# not share the issuer origin. Leave empty unless each origin is reviewed.
AEGIS_OIDC_ALLOWED_ORIGINS=
AEGIS_OIDC_CLIENT_ID=
AEGIS_OIDC_CLIENT_SECRET=
AEGIS_OIDC_AUTO_PROVISION=false
AEGIS_OIDC_TENANT_ID=1
AEGIS_OIDC_ROLE_CLAIM=roles
AEGIS_OIDC_ROLE_MAPPING={}
AEGIS_MULTI_TENANT=false
AEGIS_ENABLE_SAFETY=false
SAFETY_API_KEY=
AEGIS_EVIDENCE_SIGNING_KEY=replace-with-urlsafe-base64-encoded-32-byte-ed25519-seed
POSTGRES_PASSWORD=replace-with-a-strong-database-password
